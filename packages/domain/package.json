{
  "name": "@a3/domain",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Pure A3 domain models, validation and command planning",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "exports": {
    "./uml": { "types": "./dist/src/uml.d.ts", "import": "./dist/src/uml.js" },
    "./er": { "types": "./dist/src/er.d.ts", "import": "./dist/src/er.js" },
    "./c4": { "types": "./dist/src/c4.d.ts", "import": "./dist/src/c4.js" },
    "./shortcuts": { "types": "./dist/src/shortcuts.d.ts", "import": "./dist/src/shortcuts.js" },
    "./conceptual-diagrams": { "types": "./dist/src/conceptual-diagrams.d.ts", "import": "./dist/src/conceptual-diagrams.js" },
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./content-nodes": {
      "types": "./dist/src/content-nodes.d.ts",
      "import": "./dist/src/content-nodes.js"
    },
    "./markdown": {
      "types": "./dist/src/markdown.d.ts",
      "import": "./dist/src/markdown.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-schemas.mjs",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
