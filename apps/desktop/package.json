{
  "name": "@a3/desktop",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "A3 desktop shell for local project workspaces",
  "author": "Sigilo-dev",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "predev": "npm run build --workspace @a3/domain && npm run build --workspace @a3/project-store",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pretypecheck": "npm run build --workspace @a3/domain && npm run build --workspace @a3/project-store",
    "build": "npm run typecheck && electron-vite build",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test:smoke": "node test/run-smoke.mjs",
    "test:canvas": "node --test test/viewport.test.mjs",
    "test:code": "node --test test/code-languages.test.mjs",
    "test:focus": "node test/run-focus.mjs",
    "test:navigation": "node test/run-navigation.mjs",
    "test:conceptual": "node test/run-conceptual.mjs",
    "test:c4": "node test/run-c4.mjs",
    "test:uml": "node test/run-uml.mjs",
    "test:er": "node test/run-er.mjs"
  },
  "devDependencies": {
    "@a3/project-store": "0.1.0-dev.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@milkdown/core": "7.22.3",
    "@milkdown/plugin-listener": "7.22.3",
    "@milkdown/preset-commonmark": "7.22.3",
    "@milkdown/preset-gfm": "7.22.3",
    "@milkdown/prose": "7.22.3",
    "@milkdown/utils": "7.22.3",
    "codemirror": "6.0.2",
    "perfect-freehand": "1.2.3",
    "roughjs": "4.6.6"
  }
}
