{
  "name": "@a3/desktop",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "A3 desktop shell for local project workspaces",
  "author": "Sigilo-dev",
  "license": "MIT",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test:smoke": "node test/run-smoke.mjs"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
