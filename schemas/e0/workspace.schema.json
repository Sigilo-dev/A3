{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigilo-dev.github.io/A3/schemas/e0/workspace.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/uuid"
    },
    "revision": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/revision"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "viewport": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "additionalProperties": true
    },
    "properties": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions"
    },
    "extensions": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "name",
    "viewport",
    "properties",
    "extensions"
  ],
  "additionalProperties": true
}
