{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigilo-dev.github.io/A3/schemas/e0/visual-edge.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/uuid"
    },
    "revision": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/revision"
    },
    "sourcePlacementId": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/uuid"
    },
    "targetPlacementId": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/uuid"
    },
    "label": {
      "type": "string"
    },
    "waypoints": {
      "type": "array",
      "items": {
        "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/point"
      }
    },
    "style": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions"
    },
    "extensions": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "sourcePlacementId",
    "targetPlacementId",
    "label",
    "waypoints",
    "style",
    "extensions"
  ],
  "additionalProperties": true
}
