          "id"
        ],
        "additionalProperties": true
      },
      "uniqueItems": true
    },
    "bindings": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions"
    },
    "extensions": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "type",
    "typeVersion",
    "title",
    "tags",
    "properties",
    "ports",
    "bindings",
    "extensions"
