{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigilo-dev.github.io/A3/schemas/e1/node-package-install-lock.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packages": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "packageId": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/namespace" },
          "version": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/version" },
          "integrity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "origin": { "enum": ["builder", "file-import"] },
          "license": { "type": "string", "minLength": 1, "maxLength": 256 },
          "a3ApiVersion": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/version" },
          "status": { "enum": ["installed", "removed"] },
          "installedAt": { "type": "string", "format": "utc-date-time" },
          "removedAt": { "type": "string", "format": "utc-date-time" }
        },
        "required": ["packageId", "version", "integrity", "origin", "license", "a3ApiVersion", "status", "installedAt"],
        "additionalProperties": false
      }
    },
    "extensions": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions" }
  },
  "required": ["schemaVersion", "packages", "extensions"],
  "additionalProperties": false
}
