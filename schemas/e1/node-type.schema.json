{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigilo-dev.github.io/A3/schemas/e1/node-type.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/namespace"
    },
    "version": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/version"
    },
    "packageId": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/namespace"
    },
    "description": { "type": "string", "maxLength": 2000 },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/namespace"
          },
          "valueType": {
            "enum": [
              "string",
              "number",
              "boolean",
              "enum",
              "list",
              "reference",
              "json"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "acceptsBinding": {
            "type": "boolean"
          },
          "defaultValue": {}
        },
        "required": [
          "name",
          "valueType",
          "required"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "$ref": "https://sigilo-dev.github.io/A3/schemas/e1/value-spec.schema.json#/$defs/spec"
          }
        ]
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "label": { "type": "string", "maxLength": 120 },
          "direction": {
            "enum": [
              "input", "output"
            ]
          },
          "dataType": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/namespace" },
          "multiplicity": {
            "type": "object", "properties": { "min": { "type": "integer", "minimum": 0 }, "max": { "type": ["integer", "null"], "minimum": 0 } },
            "required": ["min", "max"], "additionalProperties": true
          }
        },
        "required": [
          "id",
          "direction"
        ],
        "additionalProperties": true
      }
    },
    "bindingFields": {
      "type": "array",
      "items": {
        "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/namespace"
      },
      "uniqueItems": true
    },
    "style": {
      "type": "object",
      "properties": {
        "icon": { "type": "string", "maxLength": 64 },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "foreground": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "borderColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "borderStyle": { "enum": ["solid", "dashed", "dotted"] },
        "width": { "type": "number", "minimum": 120, "maximum": 800 }
      },
      "additionalProperties": false
    },
    "importMappings": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e1/node-mappings.schema.json" },
    "exportMappings": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e1/node-mappings.schema.json" },
    "extensions": {
      "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "name",
    "version",
    "packageId",
    "fields",
    "ports",
    "bindingFields",
    "extensions"
  ],
  "additionalProperties": true
}
