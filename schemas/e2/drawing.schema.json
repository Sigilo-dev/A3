{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigilo-dev.github.io/A3/schemas/e2/drawing.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/uuid" },
    "revision": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/revision" },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "pressure": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["x", "y"],
        "additionalProperties": true
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 512 },
        "thinning": { "type": "number", "minimum": -1, "maximum": 1 },
        "smoothing": { "type": "number", "minimum": 0, "maximum": 1 },
        "streamline": { "type": "number", "minimum": 0, "maximum": 1 },
        "simulatePressure": { "type": "boolean" }
      },
      "required": ["size", "thinning", "smoothing", "streamline", "simulatePressure"],
      "additionalProperties": true
    },
    "style": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions" },
    "extensions": { "$ref": "https://sigilo-dev.github.io/A3/schemas/e0/common.schema.json#/$defs/extensions" }
  },
  "required": ["schemaVersion", "id", "revision", "points", "parameters", "style", "extensions"],
  "additionalProperties": true
}
