{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigilo-dev.github.io/A3/schemas/e6/versioned-extension-bundle.schema.json",
  "title": "A3 versioned extension bundle",
  "description": "Data-only extension package envelope. Point-specific semantics and safe values are checked by the A3 domain validator.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/contribution" }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "required": ["schemaVersion", "manifest", "contributions", "extensions"],
  "additionalProperties": false,
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "enum": ["local-file", "local-folder"] }, "label": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "required": ["kind", "label"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "kind": { "const": "catalog" }, "label": { "type": "string", "minLength": 1, "maxLength": 160 }, "catalogUrl": { "type": "string", "pattern": "^https://[^/?#]+$" } },
          "required": ["kind", "label", "catalogUrl"],
          "additionalProperties": false
        }
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/namespace" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "$ref": "#/$defs/version" },
        "license": { "type": "string", "minLength": 1, "maxLength": 256 },
        "a3ApiVersion": { "const": "1.0.0" },
        "origin": { "$ref": "#/$defs/origin" },
        "dependencies": { "type": "array", "maxItems": 128, "items": { "type": "object", "properties": { "id": { "$ref": "#/$defs/namespace" }, "version": { "$ref": "#/$defs/version" } }, "required": ["id", "version"], "additionalProperties": false } },
        "permissions": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/namespace" } },
        "obsidianCompatibility": { "const": "not-asserted" },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "required": ["id", "name", "author", "version", "license", "a3ApiVersion", "origin", "dependencies", "permissions", "obsidianCompatibility", "extensions"],
      "additionalProperties": false
    },
    "contribution": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/namespace" },
        "extensionPoint": { "$ref": "#/$defs/namespace" },
        "apiVersion": { "$ref": "#/$defs/version" },
        "payload": true,
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "required": ["id", "extensionPoint", "apiVersion", "payload"],
      "additionalProperties": false
    }
  }
}
